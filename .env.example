# Куда слать алерты. chat_id — он же единственный, кого слушает бот.
PULSE_TELEGRAM_TOKEN=
PULSE_TELEGRAM_CHAT_ID=

# Разбор логов упавшего сервиса
ANTHROPIC_API_KEY=
PULSE_TRIAGE_ENABLED=true

# Railway: аккаунтный или workspace-токен (проектный не подойдёт —
# у него другой заголовок и он видит только своё окружение)
RAILWAY_TOKEN=
PULSE_RAILWAY_ENVIRONMENT=production

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Как часто опрашивать
PULSE_INTERVAL_SECONDS=180

# Сколько подряд отказов подтверждают инцидент, сколько успехов закрывают,
# и через сколько минут напоминать об открытом.
PULSE_FAILURE_THRESHOLD=2
PULSE_RECOVERY_THRESHOLD=1
PULSE_REMIND_AFTER_MINUTES=120

# На Railway путь должен указывать на volume, иначе состояние
# теряется при каждом деплое.
PULSE_DB_PATH=./data/pulse.db
